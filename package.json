{
  "name": "stargazer",
  "version": "0.2.2",
  "private": true,
  "author": "Charles J. Dyas",
  "description": "An interactive solar system explorer with approximate orbital models, satellite predictions, and sourced mission data.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test": "node --test scripts/core.test.mjs scripts/landing.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:docker": "docker run --rm --ipc=host --user \"$(id -u):$(id -g)\" -e HOME=/tmp -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.63.0-noble npx playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20261003.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/three": "^0.186.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.0.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "wrangler": "^4.143.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@threlte/core": "^8.6.1",
    "@threlte/extras": "^9.22.0",
    "satellite.js": "^7.1.0",
    "three": "^0.186.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "cookie": "^0.7.2"
  }
}
