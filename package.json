{
  "name": "stargazer",
  "version": "0.1.1",
  "private": true,
  "author": "Charles J. Dyas",
  "description": "An interactive solar system explorer with approximate orbital models, satellite predictions, and sourced mission data.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test": "node --test scripts/core.test.mjs scripts/landing.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:docker": "docker run --rm --ipc=host --user \"$(id -u):$(id -g)\" -e HOME=/tmp -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.63.0-noble npx playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/three": "^0.170.0",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.0.5",
    "typescript": "^5.6.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@threlte/core": "^8.0.0",
    "@threlte/extras": "^9.0.0",
    "satellite.js": "^6.0.2",
    "three": "^0.170.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "cookie": "^0.7.2"
  }
}
